{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run build_runner (WATCH)",
      "type": "shell",
      "command": "dart run build_runner watch --force-jit",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Run barreler (WATCH)",
      "type": "shell",
      "command": "barreler watch",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Run riverpod_devtools:analyze (WATCH)",
      "type": "shell",
      "command": "dart run riverpod_devtools:analyze --watch",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Build api bindings",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/api_gen.sh",
      "options": {
        "cwd": "${workspaceFolder}/libs/api_bindings"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run application in web wasm",
      "type": "shell",
      "command": "flutter run -d chrome --wasm",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
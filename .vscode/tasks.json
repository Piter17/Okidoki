{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run build_runner",
      "type": "shell",
      "command": "dart run build_runner build --force-jit",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run build_runner (WATCH)",
      "type": "shell",
      "command": "dart run build_runner watch --force-jit",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run barreler",
      "type": "shell",
      "command": "barreler build",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run barreler (WATCH)",
      "type": "shell",
      "command": "barreler watch",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Build api bindings",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/api_gen.sh",
      "options": {
        "cwd": "${workspaceFolder}/libs/api_bindings"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
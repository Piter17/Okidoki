    "version": "0.2.0",
    "configurations": [
        {
            "name": "riv",
            "request": "launch",
            "type": "dart",
            "toolArgs": ["--enable-experiment=dot-shorthands"]
        },
        {
            "name": "riv clean-storage",
            "request": "launch",
            "type": "dart",
            "toolArgs": ["--enable-experiment=dot-shorthands"],
            "args": ["--clean-storage"]
        },
        {
            "name": "riv (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": ["--enable-experiment=dot-shorthands"]
        },
        {
            "name": "riv (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": ["--enable-experiment=dot-shorthands"]
        }
    ]
}